---
interface Props {
  title?:       string;
  description?: string;
  ogImage?:     string;
  ogUrl?:       string;
  navVariant?:  'standard' | 'editorial';
}

const {
  title       = 'Blankstate — Packs Premium',
  description = 'Ropa de calidad real. Sin logo, sin markup. Packs desde S/70. Lima, Perú.',
  ogImage     = 'https://blankstate.pe/BRANDING/banners/NUEVOS/FINALES/PACK%20BASICOS.webp',
  ogUrl       = 'https://blankstate.pe',
  navVariant  = 'standard',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta property="og:type"        content="website" />
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={ogImage} />
  <meta property="og:url"         content={ogUrl} />
  <meta name="twitter:card"       content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&family=Space+Grotesk:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --black:  #080808;
      --white:  #F6F6F6;
      --g1:     #EBEBEB;
      --g2:     #D0D0D0;
      --g3:     #A0A0A0;
      --g4:     #505050;
      --g5:     #1E1E1E;
      --serif:  'Cormorant Garamond', Georgia, serif;
      --sans:   'Space Grotesk', -apple-system, sans-serif;
      --ease:   cubic-bezier(0.4, 0, 0.2, 1);
      --spring: cubic-bezier(0.16, 1, 0.3, 1);
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--sans);
      background: var(--white);
      color: var(--black);
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    /* ── CURSOR ── */
    .cursor {
      width: 8px; height: 8px;
      background: var(--black);
      border-radius: 50%;
      position: fixed;
      top: 0; left: 0;
      pointer-events: none;
      z-index: 9999;
      transition: transform 0.15s var(--ease), width 0.3s, height 0.3s, background 0.3s;
      transform: translate(-50%, -50%);
    }
    .cursor.grow { width: 36px; height: 36px; background: transparent; border: 1.5px solid var(--black); }
    body.dark-bg .cursor { background: var(--white); }
    body.dark-bg .cursor.grow { border-color: var(--white); background: transparent; }
    @media (hover: none) { .cursor { display: none; } }

    /* ── STATIC ANNOUNCEMENT BAR (standard nav only) ── */
    .bar-static {
      background: var(--black);
      color: var(--white);
      text-align: center;
      padding: 9px 20px;
      font-size: 11px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      font-weight: 400;
    }
    @media (max-width: 480px) { .bar-static { font-size: 10px; letter-spacing: 0.07em; } }

    /* ── NAV STANDARD (pack pages) ── */
    .nav-standard {
      position: sticky; top: 0; z-index: 200;
      background: var(--white);
      border-bottom: 1px solid var(--g2);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 48px;
      height: 64px;
      transition: background 0.3s;
    }
    .nav-standard.scrolled { background: rgba(246,246,246,0.92); backdrop-filter: blur(12px); }
    @media (max-width: 900px) { .nav-standard { padding: 0 20px; } }

    .nav-logo { display: flex; align-items: center; text-decoration: none; }
    .nav-logo-wordmark {
      font-family: var(--sans); font-size: 20px; font-weight: 300;
      letter-spacing: 0.04em; color: var(--black); line-height: 1;
    }
    .nav-logo-wordmark sup { font-size: 9px; vertical-align: super; letter-spacing: 0; }

    .nav-links { display: flex; gap: 32px; list-style: none; }
    .nav-links a {
      font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
      font-weight: 400; color: var(--g4); text-decoration: none; transition: color 0.2s;
    }
    .nav-links a:hover { color: var(--black); }
    @media (max-width: 900px) { .nav-links { display: none; } }

    .nav-cta {
      display: inline-flex; align-items: center; gap: 8px;
      background: var(--black); color: var(--white); text-decoration: none;
      padding: 10px 22px; font-size: 11px; letter-spacing: 0.12em;
      text-transform: uppercase; font-weight: 500;
      transition: background 0.2s, transform 0.2s;
    }
    .nav-cta:hover { background: var(--g5); transform: translateY(-1px); }
    @media (max-width: 900px) { .nav-cta { display: none; } }

    /* ── NAV EDITORIAL (landing + catalog) ── */
    .nav-editorial {
      position: sticky; top: 0; z-index: 200;
      background: var(--white);
      border-bottom: 1px solid var(--g2);
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      padding: 0 20px;
      height: 64px;
      transition: background 0.3s;
    }
    .nav-editorial.scrolled { background: rgba(246,246,246,0.92); backdrop-filter: blur(12px); }

    .nav-logo-center { display: flex; align-items: center; text-decoration: none; justify-self: center; }

    .nav-hamburger {
      justify-self: start;
      background: none; border: none; cursor: pointer;
      font-size: 26px; color: var(--black); padding: 6px 8px;
      line-height: 1; display: flex; align-items: center; justify-content: center;
      transition: color 0.2s; font-family: var(--sans);
    }
    .nav-hamburger:hover { color: var(--g4); }

    .nav-cart {
      justify-self: end;
      position: relative; display: flex; align-items: center; justify-content: center;
      width: 36px; height: 36px;
      background: none; color: var(--black); border: none; cursor: pointer;
      transition: color 0.2s; font-family: var(--sans); padding: 0;
    }
    .nav-cart:hover { color: var(--g4); }
    .nav-cart svg { width: 20px; height: 20px; }
    #cart-badge {
      background: var(--black) !important;
      color: var(--white) !important;
      border: 2px solid var(--white) !important;
    }

    /* ── NAV MENU (shared) ── */
    .nav-menu {
      position: fixed; top: 64px; left: 0; right: 0;
      background: var(--white); border-bottom: 1px solid var(--g2);
      z-index: 190; max-height: 0; overflow: hidden;
      transition: max-height 0.45s var(--ease);
    }
    .nav-menu.open { max-height: 500px; }
    .nav-menu-inner { padding: 48px 48px 52px; }
    @media (max-width: 900px) { .nav-menu-inner { padding: 40px 20px 44px; } }

    .nav-menu-links { list-style: none; display: flex; flex-direction: column; gap: 20px; margin-bottom: 36px; }
    .nav-menu-links a {
      font-family: var(--serif); font-size: 36px; font-weight: 300;
      color: var(--black); text-decoration: none; transition: color 0.2s; line-height: 1.2;
    }
    .nav-menu-links a.active { border-bottom: 1px solid var(--black); }
    .nav-menu-links a:hover { color: var(--g3); }
    @media (max-width: 900px) { .nav-menu-links a { font-size: 28px; } }

    .nav-menu-wa { padding-top: 28px; border-top: 1px solid var(--g2); }
    .nav-menu-wa-btn {
      display: flex; align-items: center; gap: 12px;
      background: var(--black); color: var(--white); text-decoration: none;
      padding: 16px 24px; font-size: 13px; letter-spacing: 0.12em;
      text-transform: uppercase; font-weight: 500; transition: background 0.2s;
    }
    .nav-menu-wa-btn:hover { background: var(--g5); }

    /* ── FOOTER ── */
    .footer {
      background: var(--g5); padding: 52px 48px;
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 24px;
    }
    @media (max-width: 900px) { .footer { padding: 40px 20px; flex-direction: column; align-items: flex-start; gap: 20px; } }

    .footer-logo { display: flex; align-items: center; text-decoration: none; }
    .footer-logo-wordmark {
      font-family: var(--sans); font-size: 15px; font-weight: 300;
      letter-spacing: 0.04em; color: var(--g3); line-height: 1; transition: color 0.2s;
    }
    .footer-logo:hover .footer-logo-wordmark { color: var(--white); }
    .footer-logo-wordmark sup { font-size: 8px; vertical-align: super; letter-spacing: 0; }

    .footer-links { display: flex; gap: 28px; list-style: none; flex-wrap: wrap; }
    .footer-links a {
      font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--g3); text-decoration: none; transition: color 0.2s;
    }
    .footer-links a:hover { color: var(--white); }
    @media (max-width: 900px) { .footer-links { gap: 16px; } }

    .footer-copy { font-size: 11px; color: var(--g4); letter-spacing: 0.05em; }

    /* ── WHATSAPP FLOAT ── */
    .wa-float {
      display: flex; position: fixed; bottom: 24px; right: 24px; z-index: 500;
      width: 56px; height: 56px; background: var(--black); color: var(--white);
      border-radius: 50%; align-items: center; justify-content: center;
      text-decoration: none; box-shadow: 0 4px 20px rgba(0,0,0,0.35);
      transition: transform 0.25s var(--spring), background 0.2s;
    }
    .wa-float:hover { transform: scale(1.08); background: var(--g5); }
    .wa-float svg { width: 26px; height: 26px; }

    /* ── SCROLL ANIMATIONS ── */
    .reveal {
      opacity: 0; transform: translateY(28px);
      transition: opacity 0.7s var(--ease), transform 0.7s var(--ease);
    }
    .reveal.visible { opacity: 1; transform: translateY(0); }
    .reveal-delay-1 { transition-delay: 0.1s; }
    .reveal-delay-2 { transition-delay: 0.2s; }
  </style>
  <slot name="head" />
</head>
<body>

<div class="cursor" id="cursor"></div>

{navVariant === 'standard' && (
  <div class="bar-static">🚚 Envíos a todo el Perú</div>
)}

{navVariant === 'standard' ? (
  <nav class="nav-standard" id="nav">
    <a href="/" class="nav-logo">
      <span class="nav-logo-wordmark">blankstate<sup>©</sup></span>
    </a>
    <ul class="nav-links">
      <li><a href="/catalogo">Catálogo</a></li>
    </ul>
    <a href="https://wa.me/51942418379?text=Hola%2C+quiero+ver+los+packs+de+Blankstate."
       class="nav-cta" target="_blank" rel="noopener">
      WhatsApp
      <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 1.41.37 2.74 1.01 3.89L0 16l4.28-1.12A7.96 7.96 0 008 16c4.42 0 8-3.58 8-8s-3.58-8-8-8zm3.93 11.07c-.17.48-.98.93-1.36.99-.35.05-.79.07-1.27-.08a11.5 11.5 0 01-1.15-.43C6.64 10.8 5.5 9.4 5.41 9.29c-.09-.11-.73-.97-.73-1.85 0-.88.46-1.31.62-1.49.17-.18.37-.22.49-.22h.35c.11 0 .27-.04.42.32l.54 1.35c.05.11.08.24.02.38l-.2.39-.3.31c-.1.1-.2.21-.09.41.11.2.5.82 1.07 1.33.73.65 1.35.85 1.54.94.19.09.3.08.41-.05l.49-.58c.14-.18.28-.15.47-.09l1.33.63c.19.09.31.14.36.22.04.08.04.46-.13.93z"/>
      </svg>
    </a>
  </nav>
) : (
  <nav class="nav-editorial" id="nav">
    <button class="nav-hamburger" id="nav-hamburger" aria-label="Menú">≡</button>
    <a href="/" class="nav-logo-center">
      <span class="nav-logo-wordmark">blankstate<sup>©</sup></span>
    </a>
    <button class="nav-cart" id="cart-btn" aria-label="Ver carrito">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
      </svg>
      <span id="cart-badge"></span>
    </button>
  </nav>
)}

<div class="nav-menu" id="nav-menu" aria-hidden="true">
  <div class="nav-menu-inner">
    <ul class="nav-menu-links">
      <li><a href="/" class="nav-menu-link">Inicio</a></li>
      <li><a href="/catalogo" class="nav-menu-link">Catálogo</a></li>
    </ul>
    <div class="nav-menu-wa">
      <a href="https://wa.me/51942418379?text=Hola%2C+quiero+ver+los+packs+de+Blankstate."
         class="nav-menu-wa-btn" target="_blank" rel="noopener">
        Escribir por WhatsApp
        <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 1.41.37 2.74 1.01 3.89L0 16l4.28-1.12A7.96 7.96 0 008 16c4.42 0 8-3.58 8-8s-3.58-8-8-8zm3.93 11.07c-.17.48-.98.93-1.36.99-.35.05-.79.07-1.27-.08a11.5 11.5 0 01-1.15-.43C6.64 10.8 5.5 9.4 5.41 9.29c-.09-.11-.73-.97-.73-1.85 0-.88.46-1.31.62-1.49.17-.18.37-.22.49-.22h.35c.11 0 .27-.04.42.32l.54 1.35c.05.11.08.24.02.38l-.2.39-.3.31c-.1.1-.2.21-.09.41.11.2.5.82 1.07 1.33.73.65 1.35.85 1.54.94.19.09.3.08.41-.05l.49-.58c.14-.18.28-.15.47-.09l1.33.63c.19.09.31.14.36.22.04.08.04.46-.13.93z"/>
        </svg>
      </a>
    </div>
  </div>
</div>

<slot />

<footer class="footer">
  <a href="/" class="footer-logo">
    <span class="footer-logo-wordmark">blankstate<sup>©</sup></span>
  </a>
  <ul class="footer-links">
    <li><a href="/catalogo">Packs</a></li>
    <li><a href="https://instagram.com/blankstate.pe" target="_blank">@blankstate.pe</a></li>
    <li><a href="https://wa.me/51942418379" target="_blank">WhatsApp</a></li>
  </ul>
  <span class="footer-copy">© 2026 Blankstate</span>
</footer>

<a href="https://wa.me/51942418379?text=Hola%2C+quiero+ver+los+packs+de+Blankstate."
   class="wa-float" id="wa-float" target="_blank" rel="noopener" aria-label="Escribir por WhatsApp">
  <svg viewBox="0 0 16 16" fill="currentColor">
    <path d="M8 0C3.58 0 0 3.58 0 8c0 1.41.37 2.74 1.01 3.89L0 16l4.28-1.12A7.96 7.96 0 008 16c4.42 0 8-3.58 8-8s-3.58-8-8-8zm3.93 11.07c-.17.48-.98.93-1.36.99-.35.05-.79.07-1.27-.08a11.5 11.5 0 01-1.15-.43C6.64 10.8 5.5 9.4 5.41 9.29c-.09-.11-.73-.97-.73-1.85 0-.88.46-1.31.62-1.49.17-.18.37-.22.49-.22h.35c.11 0 .27-.04.42.32l.54 1.35c.05.11.08.24.02.38l-.2.39-.3.31c-.1.1-.2.21-.09.41.11.2.5.82 1.07 1.33.73.65 1.35.85 1.54.94.19.09.3.08.41-.05l.49-.58c.14-.18.28-.15.47-.09l1.33.63c.19.09.31.14.36.22.04.08.04.46-.13.93z"/>
  </svg>
</a>

<script src="/cart.js" is:inline></script>
<script>
  // ── CURSOR ──
  const cursor = document.getElementById('cursor');
  if (cursor) {
    document.addEventListener('mousemove', e => {
      cursor.style.left = e.clientX + 'px';
      cursor.style.top  = e.clientY + 'px';
    });
    document.querySelectorAll('a, button, [data-id], .pack-card, .best-card, .lifestyle-slide').forEach(el => {
      el.addEventListener('mouseenter', () => cursor.classList.add('grow'));
      el.addEventListener('mouseleave', () => cursor.classList.remove('grow'));
    });
  }

  // ── NAV SCROLL ──
  const nav = document.getElementById('nav');
  if (nav) window.addEventListener('scroll', () => nav.classList.toggle('scrolled', window.scrollY > 60));

  // ── HAMBURGER ──
  (function() {
    const btn  = document.getElementById('nav-hamburger');
    const menu = document.getElementById('nav-menu');
    if (!btn || !menu) return;
    let open = false;
    function toggle(force) {
      open = force !== undefined ? force : !open;
      menu.classList.toggle('open', open);
      menu.setAttribute('aria-hidden', String(!open));
      btn.textContent = open ? '✕' : '≡';
    }
    btn.addEventListener('click', e => { e.stopPropagation(); toggle(); });
    menu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => toggle(false)));
    document.addEventListener('click', e => {
      if (open && !menu.contains(e.target) && e.target !== btn) toggle(false);
    });
  })();

  // ── SCROLL REVEALS ──
  const revealEls = document.querySelectorAll('.reveal');
  if (revealEls.length) {
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    revealEls.forEach(el => obs.observe(el));
  }
</script>
</body>
</html>
