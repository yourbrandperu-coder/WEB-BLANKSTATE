{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "BRANDING/**",
      "use": "@vercel/static"
    },
    {
      "src": "PRODUCTOS/**",
      "use": "@vercel/static"
    }
  ],
  "headers": [
    {
      "source": "/BRANDING/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000" }]
    },
    {
      "source": "/PRODUCTOS/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
