{
  "builds": [
    {
      "src": "WEB/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "BRANDING/**",
      "use": "@vercel/static"
    },
    {
      "src": "PRODUCTOS/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/BRANDING/(.*)",
      "headers": { "cache-control": "public, max-age=31536000" },
      "continue": true
    },
    {
      "src": "/PRODUCTOS/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "/WEB/$1"
    }
  ]
}
