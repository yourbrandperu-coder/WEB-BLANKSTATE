{
  "routes": [
    { "src": "/", "dest": "/catalogo/index.html" },
    { "src": "/index.html", "dest": "/catalogo/index.html" },
    { "src": "/pack.html", "dest": "/catalogo/pack.html" },
    {
      "src": "/PRODUCTOS/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/BRANDING/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "status": 404, "dest": "/404.html" }
  ]
}
