---
import Layout from '../layouts/Layout.astro';
---
<Layout
  navVariant="editorial"
  title="Blankstate — Packs Premium"
  description="Ropa de calidad real. Sin logo, sin markup. Packs desde S/70. Lima, Perú."
  canonical="https://blankstate-zeta.vercel.app/"
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/BRANDING/banners/v2/HERO%20PRINCIPAL.png" />
    <style>
      body { animation: bodyEnter 0.45s ease both; }
      @keyframes bodyEnter { from { opacity: 0; } to { opacity: 1; } }

      /* ── HERO ── */
      .hero-slider {
        position: relative; width: 100%; aspect-ratio: 3/4; overflow: hidden; background: var(--black);
      }
      @media (min-width: 680px) { .hero-slider { aspect-ratio: 16/9; max-height: 92vh; } }

      .hero-img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }

      .hero-bottom {
        position: absolute; bottom: 0; left: 0; right: 0;
        display: flex; align-items: flex-end; justify-content: space-between;
        padding: 0 32px 52px;
      }
      @media (max-width: 480px) { .hero-bottom { padding: 0 20px 36px; } }

      .hero-label {
        font-family: var(--sans); font-size: clamp(48px, 13vw, 100px);
        font-weight: 700; color: var(--white); letter-spacing: -0.03em; line-height: 1;
      }
      .hero-arrow {
        width: 56px; height: 56px;
        border: 1.5px solid rgba(246,246,246,0.5); border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        color: var(--white); font-size: 22px; text-decoration: none; flex-shrink: 0;
        transition: background 0.25s, border-color 0.25s; font-family: var(--sans);
      }
      .hero-arrow:hover { background: var(--white); color: var(--black); border-color: var(--white); }

      /* ── CATEGORY TILES ── */
      .cat-tile {
        position: relative; width: 100%; aspect-ratio: 3/4;
        overflow: hidden; display: block; text-decoration: none; cursor: pointer;
      }
      @media (min-width: 680px) { .cat-tile { aspect-ratio: 16/9; } }

      .cat-tile-img {
        width: 100%; height: 100%; object-fit: cover; object-position: center top;
        display: block; transition: transform 0.8s var(--ease);
      }
      .cat-tile:hover .cat-tile-img { transform: scale(1.03); }

      .cat-tile-overlay {
        position: absolute; inset: 0; background: rgba(8,8,8,0.32);
        display: flex; align-items: flex-end; justify-content: space-between;
        padding: 0 32px 52px;
      }
      @media (max-width: 480px) { .cat-tile-overlay { padding: 0 20px 36px; } }

      .cat-tile-label {
        font-family: var(--sans); font-size: clamp(48px, 13vw, 100px);
        font-weight: 700; color: var(--white); letter-spacing: -0.03em; line-height: 1;
      }
      .cat-tile-arrow {
        width: 52px; height: 52px; border: 1.5px solid rgba(246,246,246,0.5);
        border-radius: 50%; display: flex; align-items: center; justify-content: center;
        color: var(--white); font-size: 20px; flex-shrink: 0;
        transition: background 0.25s, border-color 0.25s; font-family: var(--sans);
      }
      .cat-tile:hover .cat-tile-arrow { background: var(--white); color: var(--black); border-color: var(--white); }

      /* ── ANIMATED TICKER BAR ── */
      .bar {
        background: var(--black); color: var(--white);
        padding: 13px 0; font-size: 11px; letter-spacing: 0.14em;
        text-transform: uppercase; font-weight: 400;
        overflow: hidden; white-space: nowrap;
      }
      .bar-track { display: inline-flex; animation: ticker 20s linear infinite; }
      .bar-item { padding: 0 48px; display: inline-flex; align-items: center; gap: 8px; }
      .bar-sep { color: rgba(246,246,246,0.25); padding: 0 4px; }
      @keyframes ticker { from { transform: translateX(0); } to { transform: translateX(-50%); } }

      /* ── LIFESTYLE CAROUSEL ── */
      .lifestyle-section { overflow: hidden; }
      .lifestyle-viewport { overflow: hidden; width: 100%; }
      .lifestyle-track { display: flex; transition: transform 0.8s var(--ease); will-change: transform; }

      .ls-dots { display: flex; justify-content: center; align-items: center; gap: 8px; padding: 14px 0 6px; }
      .ls-dot {
        width: 7px; height: 7px; border-radius: 50%;
        border: 1px solid var(--g3); background: transparent; cursor: pointer; padding: 0;
        transition: background 0.2s, border-color 0.2s;
      }
      .ls-dot.active { background: var(--black); border-color: var(--black); }
      .lifestyle-slide { flex-shrink: 0; width: 100%; aspect-ratio: 3/4; overflow: hidden; }
      @media (min-width: 680px) { .lifestyle-slide { aspect-ratio: 16/9; } }
      .lifestyle-slide img { width: 100%; height: 100%; object-fit: cover; display: block; }

      /* ── FINAL CTA ── */
      .cta-section {
        background-color: var(--black); background-size: cover;
        background-position: center top; padding: 120px 48px;
        text-align: center; position: relative; overflow: hidden;
      }
      @media (max-width: 900px) { .cta-section { padding: 80px 24px; } }

      .cta-overlay { position: absolute; inset: 0; background: rgba(8,8,8,0.68); z-index: 0; }
      .cta-inner { position: relative; z-index: 1; }
      .cta-bg {
        position: absolute; font-family: var(--serif);
        font-size: clamp(100px, 18vw, 260px); font-weight: 300;
        color: rgba(255,255,255,0.02); top: 50%; left: 50%;
        transform: translate(-50%, -50%); white-space: nowrap; user-select: none; letter-spacing: -0.02em;
      }
      .cta-title {
        font-family: var(--serif); font-size: clamp(40px, 5vw, 72px);
        font-weight: 300; color: var(--white); margin-bottom: 20px;
        line-height: 1.1; position: relative;
      }
      .cta-sub { font-size: 14px; color: var(--g3); margin-bottom: 52px; font-weight: 300; position: relative; }
      .btn-cta-main {
        display: inline-flex; align-items: center; gap: 12px;
        background: var(--white); color: var(--black); text-decoration: none;
        padding: 18px 40px; font-size: 13px; letter-spacing: 0.12em;
        text-transform: uppercase; font-weight: 500;
        transition: background 0.2s, transform 0.3s var(--spring); position: relative;
      }
      .btn-cta-main:hover { background: var(--g1); transform: translateY(-3px); }

      /* ── MÁS VENDIDOS ── */
      .best-section { padding: 80px 0 88px; overflow: hidden; }
      @media (max-width: 900px) { .best-section { padding: 56px 0 64px; } }

      .best-header { padding: 0 48px; margin-bottom: 36px; }
      @media (max-width: 680px) { .best-header { padding: 0 20px; } }

      .best-title { font-family: var(--sans); font-size: clamp(48px, 13vw, 100px); font-weight: 700; line-height: 1; letter-spacing: -0.03em; }

      .best-scroll {
        overflow-x: auto; scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch; scrollbar-width: none;
        display: flex; cursor: grab;
      }
      .best-scroll::-webkit-scrollbar { display: none; }
      .best-scroll.grabbing { cursor: grabbing; }
      .best-scroll.grabbing * { user-select: none; }
      @media (max-width: 680px) { .best-scroll { padding: 0 20px; } }

      .best-card {
        display: block; flex-shrink: 0; width: 85vw; max-width: 480px;
        scroll-snap-align: start; cursor: pointer; background: transparent; position: relative;
        text-decoration: none;
      }
      @media (max-width: 680px) { .best-card { width: 82vw; max-width: 340px; } }

      .best-card-photo { aspect-ratio: 3/4; overflow: hidden; background: var(--g1); position: relative; }
      .best-card-photo img {
        width: 100%; height: 100%; object-fit: cover; object-position: top center;
        display: block; transition: transform 0.7s var(--ease);
      }
      .best-card:hover .best-card-photo img { transform: scale(1.04); }

      .best-card-overlay {
        position: absolute; bottom: 0; left: 0; right: 0;
        padding: 60px 20px 20px;
        background: linear-gradient(to top, rgba(8,8,8,0.5) 0%, transparent 100%);
        display: flex; align-items: flex-end; justify-content: center;
      }
      .btn-ver-pack-card {
        display: inline-flex; align-items: center; gap: 8px;
        background: var(--white); color: var(--black);
        padding: 11px 24px; font-family: var(--sans); font-size: 10px;
        letter-spacing: 0.14em; text-transform: uppercase; font-weight: 500;
        text-decoration: none; transition: background 0.2s; white-space: nowrap;
      }
      .btn-ver-pack-card:hover { background: var(--g1); }
    </style>
  </Fragment>

  <!-- ── HERO ── -->
  <section class="hero-slider" id="hero">
    <img class="hero-img"
         src="/BRANDING/banners/v2/HERO%20PRINCIPAL.png"
         alt="Blankstate"
         fetchpriority="high" loading="eager" />
    <div class="hero-bottom">
      <span class="hero-label">Prendas básicas.</span>
      <a href="/catalogo" class="hero-arrow">→</a>
    </div>
  </section>

  <!-- ── CATEGORY TILES ── -->
  <a class="cat-tile" href="/catalogo?cat=camisetas">
    <img class="cat-tile-img"
         src="/BRANDING/banners/v2/PORTADA%20CAMISETAS.png"
         alt="Camisetas" loading="lazy" />
    <div class="cat-tile-overlay">
      <span class="cat-tile-label">camisetas.</span>
      <span class="cat-tile-arrow">→</span>
    </div>
  </a>

  <a class="cat-tile" href="/catalogo?cat=packs">
    <img class="cat-tile-img"
         src="/BRANDING/banners/v2/PORTADA%20PACKS.png"
         alt="Packs" loading="lazy" />
    <div class="cat-tile-overlay">
      <span class="cat-tile-label">packs.</span>
      <span class="cat-tile-arrow">→</span>
    </div>
  </a>

  <!-- ── ANIMATED TICKER ── -->
  <div class="bar">
    <div class="bar-track">
      <span class="bar-item">— Envíos a todo el Perú</span>
      <span class="bar-sep">·</span>
      <span class="bar-item">— Somos fabricantes</span>
      <span class="bar-sep">·</span>
      <span class="bar-item">— Pagos seguros</span>
      <span class="bar-sep">·</span>
      <span class="bar-item">— Envíos a todo el Perú</span>
      <span class="bar-sep">·</span>
      <span class="bar-item">— Somos fabricantes</span>
      <span class="bar-sep">·</span>
      <span class="bar-item">— Pagos seguros</span>
      <span class="bar-sep">·</span>
    </div>
  </div>

  <!-- ── LIFESTYLE / SOCIAL PROOF ── -->
  <section class="lifestyle-section">
    <div class="lifestyle-viewport" id="ls-vp">
      <div class="lifestyle-track" id="ls-track">
        <div class="lifestyle-slide"><img src="/BRANDING/banners/cel-1.webp" alt="Blankstate lifestyle" loading="lazy" /></div>
        <div class="lifestyle-slide"><img src="/BRANDING/banners/cel-2.webp" alt="Blankstate lifestyle" loading="lazy" /></div>
        <div class="lifestyle-slide"><img src="/BRANDING/banners/cel-3.webp" alt="Blankstate lifestyle" loading="lazy" /></div>
        <div class="lifestyle-slide"><img src="/BRANDING/banners/1.webp" alt="Blankstate lifestyle" loading="lazy" /></div>
        <div class="lifestyle-slide"><img src="/BRANDING/banners/2.webp" alt="Blankstate lifestyle" loading="lazy" /></div>
        <div class="lifestyle-slide"><img src="/BRANDING/banners/3.webp" alt="Blankstate lifestyle" loading="lazy" /></div>
      </div>
    </div>
    <div class="ls-dots" id="ls-dots">
      <button class="ls-dot active" data-i="0" aria-label="Slide 1"></button>
      <button class="ls-dot" data-i="1" aria-label="Slide 2"></button>
      <button class="ls-dot" data-i="2" aria-label="Slide 3"></button>
      <button class="ls-dot" data-i="3" aria-label="Slide 4"></button>
      <button class="ls-dot" data-i="4" aria-label="Slide 5"></button>
      <button class="ls-dot" data-i="5" aria-label="Slide 6"></button>
    </div>
  </section>

  <!-- ── FINAL CTA ── -->
  <section class="cta-section" style="background-image: url('/BRANDING/portada-blank.webp');">
    <div class="cta-overlay"></div>
    <div class="cta-bg">BS</div>
    <div class="cta-inner">
      <h2 class="cta-title reveal">Elige tu pack.<br>Escríbenos ahora.</h2>
      <p class="cta-sub reveal">Respondemos en minutos.</p>
      <a href="https://wa.me/51942418379?text=Hola%2C+quiero+ver+los+packs+de+Blankstate.+%C2%BFCu%C3%A1les+tienen+disponibles%3F"
         class="btn-cta-main reveal" target="_blank" rel="noopener">
        Abrir WhatsApp
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 1.41.37 2.74 1.01 3.89L0 16l4.28-1.12A7.96 7.96 0 008 16c4.42 0 8-3.58 8-8s-3.58-8-8-8zm3.93 11.07c-.17.48-.98.93-1.36.99-.35.05-.79.07-1.27-.08a11.5 11.5 0 01-1.15-.43C6.64 10.8 5.5 9.4 5.41 9.29c-.09-.11-.73-.97-.73-1.85 0-.88.46-1.31.62-1.49.17-.18.37-.22.49-.22h.35c.11 0 .27-.04.42.32l.54 1.35c.05.11.08.24.02.38l-.2.39-.3.31c-.1.1-.2.21-.09.41.11.2.5.82 1.07 1.33.73.65 1.35.85 1.54.94.19.09.3.08.41-.05l.49-.58c.14-.18.28-.15.47-.09l1.33.63c.19.09.31.14.36.22.04.08.04.46-.13.93z"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- ── MÁS VENDIDOS ── -->
  <section class="best-section" id="mas-vendidos">
    <div class="best-header reveal">
      <h2 class="best-title">Más vendidos.</h2>
    </div>
    <div class="best-scroll" id="best-scroll">
      <a class="best-card" href="/packs/pima">
        <div class="best-card-photo">
          <img src="/BRANDING/banners/NUEVOS/FINALES/PACK%20PIMA.webp" alt="Pack Pima" loading="lazy" />
          <div class="best-card-overlay"><span class="btn-ver-pack-card">Ver pack →</span></div>
        </div>
      </a>
      <a class="best-card" href="/packs/high-cotton">
        <div class="best-card-photo">
          <img src="/BRANDING/banners/NUEVOS/FINALES/PACK%20320%20GRAMOS.webp" alt="Pack High Cotton 320g" loading="lazy" />
          <div class="best-card-overlay"><span class="btn-ver-pack-card">Ver pack →</span></div>
        </div>
      </a>
      <a class="best-card" href="/packs/basicos">
        <div class="best-card-photo">
          <img src="/BRANDING/banners/NUEVOS/FINALES/PACK%20BASICOS.webp" alt="Pack Básicos" loading="lazy" />
          <div class="best-card-overlay"><span class="btn-ver-pack-card">Ver pack →</span></div>
        </div>
      </a>
      <a class="best-card" href="/packs/dama">
        <div class="best-card-photo">
          <img src="/BRANDING/banners/NUEVOS/FINALES/PACK%20DAMA.webp" alt="Pack Dama" loading="lazy" />
          <div class="best-card-overlay"><span class="btn-ver-pack-card">Ver pack →</span></div>
        </div>
      </a>
      <a class="best-card" href="/packs/acid-wash">
        <div class="best-card-photo">
          <img src="/BRANDING/banners/NUEVOS/FINALES/PACK%20ACID%20WASH.webp" alt="Pack Acid Wash" loading="lazy" />
          <div class="best-card-overlay"><span class="btn-ver-pack-card">Ver pack →</span></div>
        </div>
      </a>
      <a class="best-card" href="/packs/hoodies">
        <div class="best-card-photo">
          <img src="/BRANDING/banners/NUEVOS/FINALES/PACK%20HOODIES.webp" alt="Pack Hoodies" loading="lazy" />
          <div class="best-card-overlay"><span class="btn-ver-pack-card">Ver pack →</span></div>
        </div>
      </a>
      <a class="best-card" href="/packs/invierno">
        <div class="best-card-photo">
          <img src="/BRANDING/banners/NUEVOS/FINALES/PACK%20OUTFIT%20INVIERNO.webp" alt="Pack Invierno" loading="lazy" />
          <div class="best-card-overlay"><span class="btn-ver-pack-card">Ver pack →</span></div>
        </div>
      </a>
      <a class="best-card" href="/packs/medium-cotton">
        <div class="best-card-photo">
          <img src="/PRODUCTOS/OVERSIZE-15-11/NEGRO/1.webp" alt="Pack Medium Cotton 280g" loading="lazy" />
          <div class="best-card-overlay"><span class="btn-ver-pack-card">Ver pack →</span></div>
        </div>
      </a>
    </div>
  </section>
</Layout>

<script>
  // ── HERO DARK BG ──
  (function() {
    const heroEl = document.getElementById('hero');
    if (!heroEl) return;
    document.body.classList.add('dark-bg');
    new IntersectionObserver(entries => {
      document.body.classList.toggle('dark-bg', entries[0].isIntersecting);
    }, { threshold: 0.05 }).observe(heroEl);
  })();

  // ── LIFESTYLE CAROUSEL ──
  (function() {
    const track  = document.getElementById('ls-track');
    const slides = document.querySelectorAll('.lifestyle-slide');
    const dots   = document.querySelectorAll('.ls-dot');
    if (!track || !slides.length) return;
    const total = slides.length;
    let current = 0;
    function goTo(idx) {
      current = ((idx % total) + total) % total;
      track.style.transform = 'translateX(-' + (current * 100) + '%)';
      dots.forEach((d, i) => d.classList.toggle('active', i === current));
    }
    setInterval(() => goTo(current + 1), 3000);
    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
  })();

  // ── DRAG SCROLL — más vendidos ──
  (function() {
    const wrap = document.getElementById('best-scroll');
    if (!wrap) return;
    let isDown = false, startX, scrollLeft, dragged = false;
    wrap.addEventListener('mousedown', e => {
      isDown = true; dragged = false; wrap.classList.add('grabbing');
      startX = e.pageX - wrap.offsetLeft; scrollLeft = wrap.scrollLeft;
    });
    wrap.addEventListener('mouseleave', () => { isDown = false; wrap.classList.remove('grabbing'); });
    wrap.addEventListener('mouseup',    () => { isDown = false; wrap.classList.remove('grabbing'); });
    wrap.addEventListener('mousemove', e => {
      if (!isDown) return;
      const delta = (e.pageX - wrap.offsetLeft) - startX;
      if (Math.abs(delta) > 6) dragged = true;
      if (!dragged) return;
      e.preventDefault();
      wrap.scrollLeft = scrollLeft - delta * 1.6;
    });
    // Solo bloquea el click si hubo un arrastre real — evita que el drag dispare una navegación no deseada
    wrap.addEventListener('click', e => {
      if (dragged) { e.preventDefault(); e.stopPropagation(); }
    }, true);
  })();
</script>
